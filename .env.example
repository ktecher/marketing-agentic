# Copy to .env and fill in only what you use. Never commit .env.

# --- LLM service (overrides config/settings.yaml) ---
# claude_code | anthropic | openai | ollama | openai_compatible
LLM_PROVIDER=claude_code
# claude_code: sonnet | opus | haiku. Other providers: their model id, e.g. claude-sonnet-5-5, gpt-5.1, qwen3.5:9b
LLM_MODEL=sonnet

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# openai_compatible (Groq, OpenRouter, Together, LM Studio...):
LLM_BASE_URL=
LLM_API_KEY=
# ollama (default http://localhost:11434):
OLLAMA_BASE_URL=

# --- Tools ---
MOCK_MODE=false
TAVILY_API_KEY=
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
