# Copy to .env and fill in only what you use. Never commit .env.

# --- LLM service (overrides config/settings.yaml) ---
# claude_code | anthropic | openai | ollama | openai_compatible
LLM_PROVIDER=claude_code
# claude_code: sonnet | opus | haiku. Other providers: their model id, e.g. claude-sonnet-5-5, gpt-5.1, qwen3.5:9b
LLM_MODEL=sonnet

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# openai_compatible (Groq, OpenRouter, Together, LM Studio...):
LLM_BASE_URL=
LLM_API_KEY=
# ollama (default http://localhost:11434):
OLLAMA_BASE_URL=

# --- Docker only (docker-compose.yml): claude_code cannot run in a container ---
DOCKER_LLM_PROVIDER=ollama
DOCKER_LLM_MODEL=qwen3.5:9b

# --- Tools ---
MOCK_MODE=false
# Google results via serper.dev (2,500 free searches, no card). Then set SEARCH_PROVIDER=ddgs,serper
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
JINA_API_KEY=
SEARCH_PROVIDER=ddgs
# ddgs engines (comma list or auto). Change if your network blocks some engines.
SEARCH_WEB_ENGINES=bing,yahoo
SEARCH_NEWS_ENGINES=auto
READER_PROVIDER=scrapling
READER_BROWSER=true
FIRECRAWL_API_KEY=
